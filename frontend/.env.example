# Copy to .env and fill in. Both are optional at build time, but the quote form
# only emails submissions when the Web3Forms key is present.

# Free key from https://web3forms.com - it is a public alias for the inbox that
# receives quote requests. Safe to expose in client-side code.
REACT_APP_WEB3FORMS_KEY=

# Optional: live Instagram feed from https://behold.so
# Leave blank to show the curated grid in src/lib/site.js
REACT_APP_INSTAGRAM_FEED_URL=
