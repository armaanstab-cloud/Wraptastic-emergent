# Copy to .env and fill in. Both are optional at build time, but the quote form
# only emails submissions when the Web3Forms key is present.

# Optional. A working key is already committed in QuoteForm.js - set this only
# to point the quote form at a different inbox. Free key from web3forms.com.
REACT_APP_WEB3FORMS_KEY=

# Unused. The live Instagram feed is the Behold widget on the Our Work page
# (src/components/BeholdFeed.js), which needs no environment variable.
REACT_APP_INSTAGRAM_FEED_URL=
